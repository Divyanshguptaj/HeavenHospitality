# Heaven Hospitality — environment template
#
# Copy to `.env` and fill in. NEVER commit `.env`.
# The API validates all of this at boot and exits with a list of problems if
# anything is missing or malformed — see apps/api/src/config/env.ts.

# ---------------------------------------------------------------------------
# Runtime
# ---------------------------------------------------------------------------
NODE_ENV=development
PORT=4000
LOG_LEVEL=debug

# ---------------------------------------------------------------------------
# Database — Neon serverless PostgreSQL
#
# DATABASE_URL        pooled endpoint (host contains "-pooler"). Used at runtime.
# DIRECT_DATABASE_URL unpooled endpoint. Used by Prisma Migrate.
#
# Both are required. Neon's pooler runs PgBouncer in transaction mode, which
# cannot run the session-level statements migrations need — pointing migrations
# at the pooled URL fails in ways that look like network errors.
#
# Get both from the Neon console: Project -> Connection Details, toggling
# "Pooled connection". Keep `sslmode=require` on both.
# ---------------------------------------------------------------------------
DATABASE_URL="postgresql://USER:PASSWORD@ep-example-123456-pooler.ap-southeast-1.aws.neon.tech/heaven?sslmode=require&pgbouncer=true&connect_timeout=15"
DIRECT_DATABASE_URL="postgresql://USER:PASSWORD@ep-example-123456.ap-southeast-1.aws.neon.tech/heaven?sslmode=require"

# ---------------------------------------------------------------------------
# Authentication — docs/0003-auth-and-sessions.md
#
# Generate each with:  node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
# They must be different from each other, and different per environment.
# ---------------------------------------------------------------------------
JWT_ACCESS_SECRET="REPLACE_ME_generate_a_48_byte_random_string"
JWT_REFRESH_SECRET="REPLACE_ME_generate_a_DIFFERENT_48_byte_random_string"
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL=30d
ACCOUNT_LOCKOUT_THRESHOLD=5
ACCOUNT_LOCKOUT_MINUTES=15

# --- Phone verification (OTP) ------------------------------------------------
#
# "mock" logs the code instead of sending an SMS. The API refuses to start with
# NODE_ENV=production unless this is "sms", so a missing gateway fails loudly
# rather than letting anyone verify any number.
OTP_PROVIDER=mock
OTP_TTL_MINUTES=10
OTP_MAX_ATTEMPTS=5
OTP_RESEND_COOLDOWN_SECONDS=60
OTP_VERIFICATION_TTL_MINUTES=15

# DEVELOPMENT ONLY. Makes every code this value so there is no log to read.
# Setting this with NODE_ENV=production is a startup error, by design.
OTP_DEV_FIXED_CODE=123456

# --- The first owner ---------------------------------------------------------
#
# There is no public route that can create an ADMIN — every signup produces a
# NON_RESIDENT — so the first admin comes from
# `pnpm db:seed`. These are the development defaults the seed falls back to —
# CHANGE THEM before any real deployment. Production refuses to start without
# the phone and password set explicitly.
# QUOTE the password. An unquoted `#` starts a comment, so a value like
# Secret#2026 silently becomes "Secret" — and you would only find out when the
# documented password did not work.
BOOTSTRAP_OWNER_PHONE=+919999999999
BOOTSTRAP_OWNER_PASSWORD="change-me-before-deploying"
BOOTSTRAP_OWNER_NAME="Property Owner"

# ---------------------------------------------------------------------------
# Business defaults
# ---------------------------------------------------------------------------
DEFAULT_TIMEZONE=Asia/Kolkata

# ---------------------------------------------------------------------------
# HTTP — comma-separated allowlist. Never "*". HTTPS only in production.
# ---------------------------------------------------------------------------
CORS_ALLOWED_ORIGINS=http://localhost:5173
JSON_BODY_LIMIT=100kb
MAX_UPLOAD_BYTES=5242880
RATE_LIMIT_WINDOW_MINUTES=15
RATE_LIMIT_MAX_REQUESTS=300

# ---------------------------------------------------------------------------
# Optional integrations.
# Absent means the feature is disabled — never that it silently half-works.
# All become REQUIRED when NODE_ENV=production.
# ---------------------------------------------------------------------------

# Error tracking. No DSN = no Sentry; local development never needs it.
# SENTRY_DSN=

# Payments — Razorpay. Use test-mode keys locally.
# KEY_SECRET signs client callbacks; WEBHOOK_SECRET signs webhooks. They differ.
# RAZORPAY_KEY_ID=
# RAZORPAY_KEY_SECRET=
# RAZORPAY_WEBHOOK_SECRET=

# Object storage (S3-compatible). Locally: MinIO via `pnpm storage:up`.
# S3_ENDPOINT=http://localhost:9000
# S3_REGION=ap-south-1
# S3_BUCKET=heaven-dev
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=

# Email
# SMTP_URL=
# MAIL_FROM="Heaven Hospitality <no-reply@heavenhospitality.in>"

# ---------------------------------------------------------------------------
# Admin app (Vite). Only VITE_-prefixed vars reach the browser bundle.
# Never put a secret here — anything in the bundle is public.
# ---------------------------------------------------------------------------
VITE_API_BASE_URL=http://localhost:4000/api/v1

# Normalise line endings: LF in the repository, native in the working tree.
* text=auto eol=lf

# Binary assets must never be normalised.
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.webp binary
*.ico binary
*.pdf binary
*.ttf binary
*.otf binary
*.woff binary
*.woff2 binary

# Lockfiles are generated; keep diffs collapsed in review tooling.
pnpm-lock.yaml linguist-generated=true -diff

# Dependencies
node_modules/
.pnpm-store/

# Build output
dist/
build/
*.tsbuildinfo

# Environment — only .env.example is committed
.env
.env.*
!.env.example

# Test / coverage
coverage/
.vitest/

# Expo / React Native
.expo/
.expo-shared/
*.jks
*.p8
*.p12
*.key
*.mobileprovision
*.orig.*

# Editors / OS
.DS_Store
Thumbs.db
.idea/
.vscode/*
!.vscode/extensions.json

# Logs
*.log
npm-debug.log*
pnpm-debug.log*

# Local database volumes
.docker-data/

# Generated from @heaven/tokens by apps/admin/scripts/generate-theme.mjs
apps/admin/src/styles/theme.generated.css

# Firebase: client config is supplied to EAS as a secret file; a service-account key must never be committed
google-services.json
GoogleService-Info.plist
*firebase-adminsdk*.json
*service-account*.json
*serviceAccount*.json

# Generated native projects (EAS builds regenerate them from app.json)
apps/mobile/android/
apps/mobile/ios/

# React Native / Metro cannot resolve pnpm's default symlinked layout reliably.
# Expo's own monorepo guidance is to use a hoisted node_modules layout.
# Trade-off: phantom dependencies become possible, so every import must have a
# matching entry in its own package.json. See docs/0001-architecture.md.
node-linker=hoisted

# Fail loudly on an out-of-date lockfile in CI rather than silently resolving.
strict-peer-dependencies=false
auto-install-peers=true

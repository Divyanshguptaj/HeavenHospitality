// Heaven Hospitality — database schema
//
// Conventions:
//   - Primary keys are UUIDv7: non-guessable, but time-ordered for index locality.
//   - Money is `Int` paise, never a float or a string. See docs/0002-money.md.
//   - Timestamps are UTC (`timestamptz`); business dates are `@db.Date`.
//   - Rates and prices are SNAPSHOT onto financial records when they are
//     generated, so changing a setting never rewrites history.
//   - Some correctness constraints cannot be expressed here and live in
//     hand-written migration SQL. Each is listed in
//     docs/0006-idempotency-and-jobs.md.

generator client {
  provider = "prisma-client-js"
}

// Neon serverless PostgreSQL.
//
// DATABASE_URL is the *pooled* endpoint (`...-pooler...`), used at runtime.
// DIRECT_DATABASE_URL is the *unpooled* endpoint, used by Prisma Migrate.
datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_DATABASE_URL")
}

// ---------------------------------------------------------------------------
// Infrastructure
// ---------------------------------------------------------------------------

enum JobStatus {
  RUNNING
  SUCCEEDED
  FAILED
}

/// One row per (job, unit of work). The unique constraint IS the lock: a second
/// concurrent run loses the insert and exits, so jobs stay correct even if the
/// deployment ever runs more than one process.
model JobRun {
  id         String    @id @default(uuid(7)) @db.Uuid
  jobName    String
  /// "2026-08" for monthly jobs, "2026-08-24" for daily ones.
  periodKey  String
  status     JobStatus @default(RUNNING)
  startedAt  DateTime  @default(now()) @db.Timestamptz(3)
  finishedAt DateTime? @db.Timestamptz(3)
  error      String?

  @@unique([jobName, periodKey])
  @@index([jobName, startedAt])
}

// ---------------------------------------------------------------------------
// Identity and access
//
// Three authenticated roles — ADMIN, RESIDENT, NON_RESIDENT — plus guests, who
// are simply unauthenticated and have no row anywhere. A guest and a signed-in
// NON_RESIDENT see the same public information; the account only adds a profile.
// ---------------------------------------------------------------------------

enum UserStatus {
  ACTIVE
  SUSPENDED
  /// Left, or exercised a deletion request: PII anonymised, financial history kept.
  DEACTIVATED
}

/// The authorisation role an account holds.
///
/// ADMIN is the person who runs the property. RESIDENT lives here. NON_RESIDENT
/// is a registered account that is not (or is no longer) a tenant — the default
/// for every account created through the public signup flow, and where a tenancy
/// returns an account when it ends.
///
/// NON_RESIDENT is deliberately powerless: everything such an account can see is
/// already served by the unauthenticated public endpoints. Promotion to RESIDENT
/// or ADMIN is an admin action on the server; no public route can reach it.
enum UserRole {
  ADMIN
  RESIDENT
  NON_RESIDENT
}

/// A person. Exists once, forever. Someone who leaves and returns gets a second
/// Tenancy under the same User, which is exactly why the phone number is unique:
/// it is how we recognise a returning resident as the same person.
model User {
  id String @id @default(uuid(7)) @db.Uuid

  /// The login identifier, always stored E.164 (+919876543210). Unique, because
  /// two rows for one number would mean two accounts for one person — and the
  /// second could never be logged into. Normalisation happens in the contract
  /// schema, so nothing reaches Prisma in another shape.
  phone String @unique

  /// Optional and NOT a login identifier: kept for receipts and notices only.
  email String? @unique

  /// Null until the number has been proven by OTP. An account without this is
  /// not allowed to hold a password, so it cannot be signed in to.
  phoneVerifiedAt DateTime? @db.Timestamptz(3)

  /// The authorisation role, and the one the access token carries.
  ///
  /// PropertyMembership also records a role, but that answers a different
  /// question: *which properties* this user is attached to. This field answers
  /// "what may this account do at all", which is what route guards need before
  /// any property is in scope. The seed keeps the two consistent.
  role UserRole @default(NON_RESIDENT)

  fullName     String
  passwordHash String?
  status       UserStatus @default(ACTIVE)

  /// Set on an owner-provisioned account until the first password is chosen.
  mustChangePassword Boolean @default(false)

  // Brute-force protection, persisted in PostgreSQL because per-IP limits reset
  // on deploy and are evaded by rotating IPs. See docs/0003-auth-and-sessions.md.
  failedLoginAttempts Int       @default(0)
  lockedUntil         DateTime? @db.Timestamptz(3)
  lastFailedLoginAt   DateTime? @db.Timestamptz(3)
  lastLoginAt         DateTime? @db.Timestamptz(3)

  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)

  memberships PropertyMembership[]
  sessions    RefreshSession[]
  auditLogs   AuditLog[]
  tenancies   Tenancy[]
  complaints  Complaint[]

  @@index([status])
  @@index([role])
}

enum OtpPurpose {
  SIGNUP
  PASSWORD_RESET
}

/// A one-time code sent to a phone number, and the state that makes it safe.
///
/// Server-side by necessity: a code the client could inspect or re-use is not a
/// verification of anything. The row carries its own expiry, attempt counter and
/// consumed flag so that "is this code still usable" is answerable from the row
/// alone, without a cache or a scheduler.
model OtpVerification {
  id String @id @default(uuid(7)) @db.Uuid

  /// E.164. Not a foreign key: signup verifies a number BEFORE any User exists.
  phone   String
  purpose OtpPurpose

  /// SHA-256 of the code. A six-digit code has too little entropy for Argon2 to
  /// be worth its cost here — the protection comes from the attempt limit and
  /// the short expiry, not from the hash. Hashing still means a database leak
  /// does not hand over live codes.
  codeHash String

  attempts   Int       @default(0)
  expiresAt  DateTime  @db.Timestamptz(3)
  /// Set the moment the code is accepted; a consumed code is never valid again.
  consumedAt DateTime? @db.Timestamptz(3)

  /// Proof-of-verification handed to the client, so the next step (set password)
  /// can be authorised without re-sending the code. Hashed for the same reason
  /// the code is. Null until the code is verified.
  verificationTokenHash String?   @unique
  verificationExpiresAt DateTime? @db.Timestamptz(3)

  createdAt DateTime @default(now()) @db.Timestamptz(3)

  /// Serves the resend cooldown and the "most recent code wins" lookup.
  @@index([phone, purpose, createdAt])
}

model PropertyMembership {
  id         String   @id @default(uuid(7)) @db.Uuid
  userId     String   @db.Uuid
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  propertyId String   @db.Uuid
  property   Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  /// Only ADMIN and RESIDENT are meaningful here: a membership records where an
  /// account holds authority, and a non-resident holds none anywhere.
  role       UserRole

  createdAt DateTime @default(now()) @db.Timestamptz(3)

  @@unique([userId, propertyId])
  @@index([propertyId, role])
}

/// A refresh token, stored only as a SHA-256 hash. Tokens belong to a family:
/// presenting a revoked token means it was replayed, so the family is revoked.
model RefreshSession {
  id     String @id @default(uuid(7)) @db.Uuid
  userId String @db.Uuid
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  tokenHash String @unique
  familyId  String @db.Uuid

  deviceLabel String?
  ipAddress   String?

  createdAt    DateTime  @default(now()) @db.Timestamptz(3)
  expiresAt    DateTime  @db.Timestamptz(3)
  revokedAt    DateTime? @db.Timestamptz(3)
  replacedById String?   @db.Uuid

  @@index([userId, revokedAt])
  @@index([familyId])
}

enum AuditAction {
  RESIDENT_ADDED
  RESIDENT_MOVED
  RESIDENT_EXITED
  BED_ASSIGNED
  BED_RELEASED
  PAYMENT_RECORDED
  PAYMENT_CONFIRMED
  INVOICE_ISSUED
  INVOICE_ADJUSTED
  ELECTRICITY_READING_ADDED
  ELECTRICITY_READING_CORRECTED
  COMPLAINT_RAISED
  COMPLAINT_UPDATED
  SETTINGS_CHANGED
  ROOM_CREATED
  ROOM_UPDATED
  FLOOR_CREATED
  ATTENDANCE_OVERRIDDEN
}

/// Append-only. `before`/`after` hold a redacted field allowlist, never a whole
/// row — an unrestricted diff would make this the leakiest table in the database.
/// Doubles as the dashboard's recent-activity feed.
model AuditLog {
  id String @id @default(uuid(7)) @db.Uuid

  actorUserId String? @db.Uuid
  actorUser   User?   @relation(fields: [actorUserId], references: [id], onDelete: SetNull)
  actorRole   String?

  action     AuditAction
  entityType String
  entityId   String?
  propertyId String?     @db.Uuid
  /// Human-readable line for the activity feed, written at the call site.
  summary    String

  before Json?
  after  Json?

  ipAddress String?
  requestId String?

  createdAt DateTime @default(now()) @db.Timestamptz(3)

  @@index([propertyId, createdAt])
  @@index([entityType, entityId])
}

// ---------------------------------------------------------------------------
// Property, floors, rooms, beds
// ---------------------------------------------------------------------------

enum PropertyStatus {
  ACTIVE
  INACTIVE
}

model Property {
  id          String         @id @default(uuid(7)) @db.Uuid
  slug        String         @unique
  name        String
  tagline     String?
  description String?
  status      PropertyStatus @default(ACTIVE)

  isPubliclyListed Boolean @default(true)

  /// Business rules (due dates, mess cutoffs, late fees) run in this timezone,
  /// never the server's or the device's.
  timezone String @default("Asia/Kolkata")
  currency String @default("INR")

  addressLine String
  locality    String
  city        String
  state       String
  pincode     String
  latitude    Decimal? @db.Decimal(9, 6)
  longitude   Decimal? @db.Decimal(9, 6)

  contactPhone  String
  /// Separate from contactPhone: many properties publish a WhatsApp-only number.
  /// Null means "no WhatsApp channel", not "same as the phone" — guessing wrong
  /// would send enquiries into a void.
  whatsappPhone String?
  contactEmail  String?

  /// The single image the public home screen leads with. A URL rather than a
  /// PropertyPhoto foreign key: the hero is a presentation choice the owner
  /// makes once, and coupling it to a gallery row means deleting a photo can
  /// silently blank the landing screen.
  heroImageUrl String?

  /// Short scannable selling points ("Walk to Karve Road", "Meals included").
  /// Owner-editable text, so it belongs in the database rather than in a
  /// component — changing it must never require a mobile release.
  highlights String[]

  /// Free text shown on the public property page: visiting hours, what to bring,
  /// notice periods. Prose, because every property words this differently.
  checkInInfo String?

  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)

  menuOverrides    MenuOverride[]
  settings         PropertySettings?
  memberships      PropertyMembership[]
  photos           PropertyPhoto[]
  facilities       Facility[]
  rules            PropertyRule[]
  floors           Floor[]
  rooms            Room[]
  tenancies        Tenancy[]
  invoices         Invoice[]
  payments         Payment[]
  menuItems        WeeklyMenuItem[]
  mealTimings      MealTiming[]
  complaints       Complaint[]
  notices          Notice[]
  staff            Staff[]
  inventory        InventoryItem[]
  expenses         Expense[]
  reminders        ReminderEvent[]
  meterReadings    MeterReading[]
  receiptSequences ReceiptSequence[]

  @@index([isPubliclyListed, status])
}

/// Owner-configurable values that must never be hard-coded in business logic
/// (spec §10, §25). One row per property.
model PropertySettings {
  id         String   @id @default(uuid(7)) @db.Uuid
  propertyId String   @unique @db.Uuid
  property   Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)

  // --- Financial ---
  /// Day of month rent falls due, 1-28 (28 so every month has the day).
  rentDueDay                  Int @default(5)
  /// Days after the due date before a late fee starts accruing.
  graceDays                   Int @default(3)
  lateFeePerDayPaise          Int @default(10000)
  /// Hard cap per invoice. Uncapped accrual produces balances nobody collects.
  lateFeeCapPaise             Int @default(300000)
  electricityRatePaisePerUnit Int @default(1300)

  // --- Payment details shown to residents (and guests when public) ---
  bankAccountName   String?
  bankAccountNumber String?
  bankIfsc          String?
  bankName          String?
  upiId             String?
  upiQrImageUrl     String?

  /// Two independent switches, because they are two different disclosures.
  ///
  /// A UPI id is a payment handle and is routinely printed on a counter; a bank
  /// account number plus IFSC is the pair used to spoof a payment request. An
  /// owner who wants the first published almost never wants the second, so a
  /// single flag would force a choice nobody wants to make.
  ///
  /// Both default to false, and the public API filters on them at the QUERY, not
  /// in the client — a value that is not published never leaves the database.
  showBankDetailsPublicly Boolean @default(false)
  showUpiPublicly         Boolean @default(false)

  // --- Mess ---
  /// Local time-of-day after which a resident may no longer change an absence.
  mealCutoffLocalTime String @default("21:00")

  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)
}

/// The public gallery: image METADATA in PostgreSQL, bytes in object storage.
///
/// The row is the record; the file is a blob addressed by `storageKey`. Storing
/// the key rather than only a URL is what lets the bucket, CDN or signing scheme
/// change later without rewriting rows — `url` is the currently-resolvable
/// address, `storageKey` is the identity.
model PropertyPhoto {
  id         String   @id @default(uuid(7)) @db.Uuid
  propertyId String   @db.Uuid
  property   Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)

  /// Where the bytes live in the configured object store, e.g.
  /// "property/<id>/gallery/<uuid>.jpg". Null for images seeded or entered as a
  /// plain external URL, which is the development path.
  storageKey String?
  url        String
  caption    String?

  /// Unpublishing is reversible; deleting is not. The owner will want to take a
  /// photo down during renovation and put it back, so the public read filters on
  /// this rather than expecting a delete.
  isActive  Boolean @default(true)
  sortOrder Int     @default(0)

  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)

  @@index([propertyId, isActive, sortOrder])
}

model Facility {
  id         String   @id @default(uuid(7)) @db.Uuid
  propertyId String   @db.Uuid
  property   Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)

  name        String
  description String?

  /// A SEMANTIC key ("wifi", "power-backup"), never a component or icon-font
  /// name. The client owns a fixed map from key to glyph, so the database can
  /// never name something the client will render blindly, and an unknown key
  /// degrades to a neutral default instead of breaking the screen.
  iconKey String?

  isActive  Boolean @default(true)
  sortOrder Int     @default(0)

  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)

  @@unique([propertyId, name])
  @@index([propertyId, isActive, sortOrder])
}

/// A house rule. Split into a scannable title and the detail behind it, because
/// a wall of prose is not read — "Entry cutoff" with "Doors close at 11:00 PM…"
/// is, and it also gives staff and residents a stable name to refer to.
model PropertyRule {
  id         String   @id @default(uuid(7)) @db.Uuid
  propertyId String   @db.Uuid
  property   Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)

  title       String
  description String

  isActive  Boolean @default(true)
  sortOrder Int     @default(0)

  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)

  @@index([propertyId, isActive, sortOrder])
}

/// A floor is a real, owner-managed entity (spec §4): created, renamed and
/// deleted, with rooms belonging to it.
model Floor {
  id         String   @id @default(uuid(7)) @db.Uuid
  propertyId String   @db.Uuid
  property   Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  /// "Ground Floor", "First Floor".
  name       String
  /// Sort key; 0 = ground. Also what "floor number" means operationally.
  level      Int

  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)

  rooms Room[]

  @@unique([propertyId, name])
  @@unique([propertyId, level])
  @@index([propertyId, level])
}

enum RoomStatus {
  ACTIVE
  MAINTENANCE
  INACTIVE
}

/// Rent lives here, not on a room-type table: the owner sets rent per room
/// (spec §9), and a resident-specific override sits on the Tenancy.
model Room {
  id         String   @id @default(uuid(7)) @db.Uuid
  propertyId String   @db.Uuid
  property   Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  floorId    String   @db.Uuid
  floor      Floor    @relation(fields: [floorId], references: [id], onDelete: Restrict)

  number           String
  /// Display label used for public grouping, e.g. "3 Sharing".
  roomType         String
  capacity         Int
  monthlyRentPaise Int
  isAirConditioned Boolean    @default(false)
  description      String?
  facilities       String[]
  status           RoomStatus @default(ACTIVE)

  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)

  beds          Bed[]
  meterReadings MeterReading[]

  @@unique([propertyId, number])
  @@index([propertyId, status])
  @@index([floorId])
}

enum BedStatus {
  AVAILABLE
  OCCUPIED
  MAINTENANCE
  BLOCKED
}

model Bed {
  id     String    @id @default(uuid(7)) @db.Uuid
  roomId String    @db.Uuid
  room   Room      @relation(fields: [roomId], references: [id], onDelete: Cascade)
  label  String
  status BedStatus @default(AVAILABLE)

  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)

  allocations Allocation[]

  @@unique([roomId, label])
  @@index([status])
}

// ---------------------------------------------------------------------------
// Residents
// ---------------------------------------------------------------------------

enum TenancyStatus {
  ACTIVE
  NOTICE_PERIOD
  VACATED
}

/// One *stay*. A person who leaves and returns gets a second Tenancy, which is
/// what keeps history intact instead of overwriting it.
model Tenancy {
  id         String   @id @default(uuid(7)) @db.Uuid
  propertyId String   @db.Uuid
  property   Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  userId     String   @db.Uuid
  user       User     @relation(fields: [userId], references: [id], onDelete: Restrict)

  status TenancyStatus @default(ACTIVE)

  joiningDate      DateTime  @db.Date
  expectedExitDate DateTime? @db.Date
  actualExitDate   DateTime? @db.Date

  /// Overrides the room rent when set — otherwise the room's rent applies.
  monthlyRentOverridePaise Int?
  securityDepositPaise     Int  @default(0)

  emergencyContactName  String?
  emergencyContactPhone String?

  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)

  allocations       Allocation[]
  invoices          Invoice[]
  payments          Payment[]
  mealAbsences      MealAbsence[]
  electricityShares ElectricityShare[]

  @@index([propertyId, status])
  @@index([userId])
}

/// Bed occupancy over time. A room change closes one row and opens another, so
/// history is preserved by construction.
///
/// A partial unique index (hand-written in the migration) enforces at most one
/// OPEN allocation per bed and per tenancy — this is what makes two staff
/// assigning the same bed simultaneously impossible rather than merely unlikely.
model Allocation {
  id        String  @id @default(uuid(7)) @db.Uuid
  tenancyId String  @db.Uuid
  tenancy   Tenancy @relation(fields: [tenancyId], references: [id], onDelete: Cascade)
  bedId     String  @db.Uuid
  bed       Bed     @relation(fields: [bedId], references: [id], onDelete: Restrict)

  startedAt DateTime  @db.Date
  endedAt   DateTime? @db.Date
  reason    String?

  createdAt DateTime @default(now()) @db.Timestamptz(3)

  @@index([bedId, endedAt])
  @@index([tenancyId, endedAt])
}

// ---------------------------------------------------------------------------
// Billing
// ---------------------------------------------------------------------------

enum InvoiceStatus {
  DRAFT
  ISSUED
  PARTIALLY_PAID
  PAID
  OVERDUE
  CANCELLED
}

enum InvoiceItemKind {
  RENT
  ELECTRICITY
  LATE_FEE
  OTHER
  DISCOUNT
}

model Invoice {
  id         String   @id @default(uuid(7)) @db.Uuid
  propertyId String   @db.Uuid
  property   Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  tenancyId  String   @db.Uuid
  tenancy    Tenancy  @relation(fields: [tenancyId], references: [id], onDelete: Cascade)

  /// "2026-09". With tenancyId this makes monthly generation idempotent.
  periodKey String
  number    String @unique

  status    InvoiceStatus @default(ISSUED)
  issueDate DateTime      @db.Date
  dueDate   DateTime      @db.Date

  /// Sum of items. Recomputed by the service, never sent by a client.
  totalPaise      Int @default(0)
  amountPaidPaise Int @default(0)

  /// Set when the owner waives the late fee; the fee function respects it.
  lateFeeWaivedAt DateTime? @db.Timestamptz(3)
  notes           String?

  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)

  items       InvoiceItem[]
  allocations PaymentAllocation[]
  receipts    Receipt[]

  @@unique([tenancyId, periodKey])
  @@index([propertyId, status])
  @@index([propertyId, periodKey])
  @@index([dueDate])
}

model InvoiceItem {
  id          String          @id @default(uuid(7)) @db.Uuid
  invoiceId   String          @db.Uuid
  invoice     Invoice         @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  kind        InvoiceItemKind
  /// Shown on the invoice, e.g. "Electricity — 60 units @ ₹13.00".
  description String
  amountPaise Int

  /// Traces a line back to what produced it (an electricity share, a reading).
  sourceType String?
  sourceId   String?

  createdAt DateTime @default(now()) @db.Timestamptz(3)

  @@index([invoiceId])
}

enum PaymentMethod {
  CASH
  UPI
  BANK_TRANSFER
  ONLINE
}

enum PaymentStatus {
  PENDING
  PAID
  FAILED
  CANCELLED
}

model Payment {
  id         String   @id @default(uuid(7)) @db.Uuid
  propertyId String   @db.Uuid
  property   Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  tenancyId  String   @db.Uuid
  tenancy    Tenancy  @relation(fields: [tenancyId], references: [id], onDelete: Cascade)

  amountPaise Int
  method      PaymentMethod
  status      PaymentStatus @default(PENDING)

  /// Provider name ("mock" today, "razorpay" later) and its identifiers. Kept
  /// generic so swapping providers does not touch the billing domain.
  provider          String?
  providerOrderId   String?
  providerPaymentId String? @unique

  /// UTR / cheque number for a manually recorded payment.
  reference String?
  notes     String?
  paidAt    DateTime? @db.Timestamptz(3)

  /// Who keyed it in. Null for resident-initiated online payments.
  recordedByUserId String? @db.Uuid

  /// Any amount not applied to an invoice, held as resident credit.
  unallocatedPaise Int @default(0)

  /// Set by the client on retryable writes so a double submit cannot pay twice.
  idempotencyKey String? @unique

  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)

  allocations PaymentAllocation[]
  receipts    Receipt[]

  @@index([propertyId, status])
  @@index([tenancyId, createdAt])
}

/// Records where each paise of a payment landed, so one payment can span
/// invoices and one invoice can receive many payments.
model PaymentAllocation {
  id          String  @id @default(uuid(7)) @db.Uuid
  paymentId   String  @db.Uuid
  payment     Payment @relation(fields: [paymentId], references: [id], onDelete: Cascade)
  invoiceId   String  @db.Uuid
  invoice     Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  amountPaise Int

  createdAt DateTime @default(now()) @db.Timestamptz(3)

  @@unique([paymentId, invoiceId])
  @@index([invoiceId])
}

/// Gapless sequential receipt numbers per property per financial year, which
/// Indian bookkeeping expects. Locked with SELECT … FOR UPDATE inside the
/// payment transaction — `count() + 1` races.
model ReceiptSequence {
  id         String   @id @default(uuid(7)) @db.Uuid
  propertyId String   @db.Uuid
  property   Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  /// "2026-27".
  fiscalYear String
  lastNumber Int      @default(0)

  @@unique([propertyId, fiscalYear])
}

model Receipt {
  id        String   @id @default(uuid(7)) @db.Uuid
  paymentId String   @db.Uuid
  payment   Payment  @relation(fields: [paymentId], references: [id], onDelete: Cascade)
  invoiceId String?  @db.Uuid
  invoice   Invoice? @relation(fields: [invoiceId], references: [id], onDelete: SetNull)

  number   String   @unique
  issuedAt DateTime @default(now()) @db.Timestamptz(3)
  /// Frozen copy of what the receipt says, so a later edit upstream cannot
  /// silently change an issued receipt.
  snapshot Json

  @@index([paymentId])
}

// ---------------------------------------------------------------------------
// Electricity
// ---------------------------------------------------------------------------

enum ReadingStatus {
  ACTIVE
  CORRECTED
}

/// A meter reading for a room in a billing month. The rate in force is snapshot
/// here, so changing the setting later never rewrites an issued bill.
model MeterReading {
  id         String   @id @default(uuid(7)) @db.Uuid
  propertyId String   @db.Uuid
  property   Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  roomId     String   @db.Uuid
  room       Room     @relation(fields: [roomId], references: [id], onDelete: Cascade)

  /// "2026-09".
  periodKey        String
  previousReading  Int
  currentReading   Int
  units            Int
  ratePaisePerUnit Int
  amountPaise      Int

  status               ReadingStatus @default(ACTIVE)
  correctedByReadingId String?       @db.Uuid
  recordedByUserId     String?       @db.Uuid
  readingDate          DateTime      @db.Date
  notes                String?

  createdAt DateTime @default(now()) @db.Timestamptz(3)

  shares ElectricityShare[]

  /// One ACTIVE reading per room per month; a correction supersedes rather than
  /// overwrites. Enforced by a partial unique index in the migration.
  @@index([propertyId, periodKey])
  @@index([roomId, periodKey])
}

/// A room's electricity split across the residents who occupied it that month.
model ElectricityShare {
  id        String       @id @default(uuid(7)) @db.Uuid
  readingId String       @db.Uuid
  reading   MeterReading @relation(fields: [readingId], references: [id], onDelete: Cascade)
  tenancyId String       @db.Uuid
  tenancy   Tenancy      @relation(fields: [tenancyId], references: [id], onDelete: Cascade)

  sharePaise   Int
  /// Recorded so the split is explainable months later.
  occupiedDays Int

  createdAt DateTime @default(now()) @db.Timestamptz(3)

  @@unique([readingId, tenancyId])
  @@index([tenancyId])
}

// ---------------------------------------------------------------------------
// Mess
// ---------------------------------------------------------------------------

enum MealType {
  BREAKFAST
  LUNCH
  DINNER
}

/// One meal on one weekday — the repeating menu, the thing the kitchen cooks in
/// an ordinary week.
///
/// `items` is a list, not a sentence: the UI renders dishes as separate lines,
/// and a list is what the owner will edit. `description` is for the note beside
/// them ("sweet dish on request"), never for the dishes themselves.
model WeeklyMenuItem {
  id          String   @id @default(uuid(7)) @db.Uuid
  propertyId  String   @db.Uuid
  property    Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  /// ISO-8601: 1 = Monday … 7 = Sunday.
  dayOfWeek   Int
  mealType    MealType
  items       String[]
  description String?

  /// Lets the owner take a meal off the published menu (a mess that serves no
  /// Sunday breakfast) without deleting the row and losing what it used to be.
  isActive Boolean @default(true)

  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)

  @@unique([propertyId, dayOfWeek, mealType])
  @@index([propertyId, dayOfWeek])
}

/// A one-off menu for a specific DATE, replacing the weekly item for that meal.
///
/// Kept as a separate table rather than as edits to WeeklyMenuItem so a festival
/// special on the 30th does not destroy what "Sunday dinner" normally is. The
/// weekly menu stays the standing answer; this is the exception, and it expires
/// on its own the moment the date passes.
///
/// Deliberately not a scheduling system: one date, one meal, one row.
model MenuOverride {
  id         String   @id @default(uuid(7)) @db.Uuid
  propertyId String   @db.Uuid
  property   Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)

  /// A business date in the property's timezone, not a timestamp.
  date        DateTime @db.Date
  mealType    MealType
  items       String[]
  description String?

  /// A cancelled special reverts to the weekly menu rather than showing nothing.
  isActive Boolean @default(true)

  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)

  /// One override per meal per day — two "specials" for the same dinner is not a
  /// state the kitchen or the screen can resolve.
  @@unique([propertyId, date, mealType])
  @@index([propertyId, date])
}

/// When each meal is served. Read from the database by every screen that shows a
/// time, so the owner changing dinner to 8:30 needs no release.
model MealTiming {
  id         String   @id @default(uuid(7)) @db.Uuid
  propertyId String   @db.Uuid
  property   Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  mealType   MealType
  /// Local times in the property's timezone, "HH:mm" — e.g. "08:00" / "09:30".
  startsAt   String
  endsAt     String

  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)

  @@unique([propertyId, mealType])
}

/// Absence is opt-out: everyone is expected unless they say otherwise, which is
/// far less data and far less friction than opt-in attendance.
model MealAbsence {
  id        String   @id @default(uuid(7)) @db.Uuid
  tenancyId String   @db.Uuid
  tenancy   Tenancy  @relation(fields: [tenancyId], references: [id], onDelete: Cascade)
  date      DateTime @db.Date
  mealType  MealType

  /// True when the owner corrected it rather than the resident declaring it.
  overriddenByOwner Boolean @default(false)

  createdAt DateTime @default(now()) @db.Timestamptz(3)

  /// Prevents duplicate submissions at the database level.
  @@unique([tenancyId, date, mealType])
  @@index([date, mealType])
}

// ---------------------------------------------------------------------------
// Complaints and notices
// ---------------------------------------------------------------------------

enum ComplaintCategory {
  PLUMBING
  ELECTRICAL
  CARPENTER
  WIFI
  CLEANING
  AC
  FURNITURE
  OTHER
}

enum ComplaintStatus {
  OPEN
  IN_PROGRESS
  RESOLVED
  CLOSED
}

model Complaint {
  id             String   @id @default(uuid(7)) @db.Uuid
  propertyId     String   @db.Uuid
  property       Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  /// The resident who raised it. Ownership is what stops one resident reading
  /// another's complaint.
  raisedByUserId String   @db.Uuid
  raisedBy       User     @relation(fields: [raisedByUserId], references: [id], onDelete: Cascade)
  tenancyId      String?  @db.Uuid

  title       String
  description String
  category    ComplaintCategory
  status      ComplaintStatus   @default(OPEN)
  imageUrl    String?

  resolvedAt  DateTime? @db.Timestamptz(3)
  reopenCount Int       @default(0)

  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)

  events ComplaintEvent[]

  @@index([propertyId, status])
  @@index([raisedByUserId, createdAt])
}

/// Status history and notes in one timeline, rather than two tables that can
/// disagree about the order things happened.
model ComplaintEvent {
  id          String           @id @default(uuid(7)) @db.Uuid
  complaintId String           @db.Uuid
  complaint   Complaint        @relation(fields: [complaintId], references: [id], onDelete: Cascade)
  fromStatus  ComplaintStatus?
  toStatus    ComplaintStatus?
  note        String?
  actorUserId String?          @db.Uuid

  createdAt DateTime @default(now()) @db.Timestamptz(3)

  @@index([complaintId, createdAt])
}

model Notice {
  id         String    @id @default(uuid(7)) @db.Uuid
  propertyId String    @db.Uuid
  property   Property  @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  title      String
  body       String
  /// Inclusive window during which residents see it.
  startsOn   DateTime  @db.Date
  endsOn     DateTime? @db.Date
  isPinned   Boolean   @default(false)

  createdAt DateTime @default(now()) @db.Timestamptz(3)

  @@index([propertyId, startsOn])
}

// ---------------------------------------------------------------------------
// Staff, inventory and expenses (spec §19 — deliberately simple)
// ---------------------------------------------------------------------------

model Staff {
  id                 String   @id @default(uuid(7)) @db.Uuid
  propertyId         String   @db.Uuid
  property           Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  fullName           String
  role               String
  phone              String?
  monthlySalaryPaise Int?
  isActive           Boolean  @default(true)
  joinedOn           DateTime @db.Date

  createdAt DateTime @default(now()) @db.Timestamptz(3)

  attendance StaffAttendance[]

  @@index([propertyId, isActive])
}

enum AttendanceStatus {
  PRESENT
  ABSENT
  HALF_DAY
  LEAVE
}

model StaffAttendance {
  id      String           @id @default(uuid(7)) @db.Uuid
  staffId String           @db.Uuid
  staff   Staff            @relation(fields: [staffId], references: [id], onDelete: Cascade)
  date    DateTime         @db.Date
  status  AttendanceStatus

  createdAt DateTime @default(now()) @db.Timestamptz(3)

  @@unique([staffId, date])
  @@index([date])
}

model InventoryItem {
  id            String    @id @default(uuid(7)) @db.Uuid
  propertyId    String    @db.Uuid
  property      Property  @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  name          String
  category      String
  quantity      Int       @default(0)
  unitCostPaise Int?
  purchasedOn   DateTime? @db.Date
  notes         String?

  createdAt DateTime @default(now()) @db.Timestamptz(3)

  @@index([propertyId, category])
}

model Expense {
  id          String   @id @default(uuid(7)) @db.Uuid
  propertyId  String   @db.Uuid
  property    Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  title       String
  category    String
  amountPaise Int
  spentOn     DateTime @db.Date
  notes       String?

  createdAt DateTime @default(now()) @db.Timestamptz(3)

  @@index([propertyId, spentOn])
}

// ---------------------------------------------------------------------------
// Notifications (spec §20 — architecture now, provider later)
// ---------------------------------------------------------------------------

enum ReminderKind {
  BEFORE_DUE
  ON_DUE
  AFTER_DUE
}

enum ReminderChannel {
  IN_APP
  WHATSAPP
  EMAIL
}

enum ReminderStatus {
  PENDING
  SENT
  FAILED
  SKIPPED
}

/// A rent reminder. The provider is mocked for now: events are recorded and
/// shown in the owner UI, and a real WhatsApp/email sender drops in behind the
/// same interface without touching this table.
model ReminderEvent {
  id         String   @id @default(uuid(7)) @db.Uuid
  propertyId String   @db.Uuid
  property   Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  invoiceId  String?  @db.Uuid
  tenancyId  String?  @db.Uuid

  kind    ReminderKind
  channel ReminderChannel @default(IN_APP)
  status  ReminderStatus  @default(PENDING)

  /// Encodes the business meaning, e.g. "rent:<tenancyId>:2026-09:ON_DUE".
  /// Unique, so re-running the job cannot send the same reminder twice.
  dedupeKey String @unique

  message   String
  sentAt    DateTime? @db.Timestamptz(3)
  attempts  Int       @default(0)
  lastError String?

  createdAt DateTime @default(now()) @db.Timestamptz(3)

  @@index([propertyId, status])
}

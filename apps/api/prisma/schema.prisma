// Heaven Hospitality — database schema
//
// Phase 2 (foundation) defines only the two infrastructure tables that have no
// foreign keys and are fully specified by docs/0006-idempotency-and-jobs.md.
// Domain models (User, Property, Room, Bed, Tenancy, Invoice, ...) arrive with
// their vertical slices, so that every table lands with its constraints, its
// service and its tests at the same time.
//
// Conventions:
//   - Primary keys are UUIDv7: non-guessable, but time-ordered for index locality.
//   - Money is `Int` paise. See docs/0002-money.md.
//   - Timestamps are stored UTC (`timestamptz`); business dates use `@db.Date`.
//   - Some correctness constraints cannot be expressed here and live in
//     hand-written migration SQL. Each is documented in
//     docs/0006-idempotency-and-jobs.md.

generator client {
  provider = "prisma-client-js"
}

// Neon serverless PostgreSQL.
//
// DATABASE_URL is the *pooled* endpoint (`...-pooler...`), used at runtime.
// DIRECT_DATABASE_URL is the *unpooled* endpoint, used by Prisma Migrate.
//
// Both are needed: Neon's pooler runs PgBouncer in transaction mode, which cannot
// execute the session-level statements migrations require. Pointing migrations at
// the pooled URL fails in ways that look like network errors.
datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_DATABASE_URL")
}

enum JobStatus {
  RUNNING
  SUCCEEDED
  FAILED
}

/// One row per (job, unit of work). The unique constraint IS the lock: a second
/// concurrent run loses the insert and exits, so correctness holds even if the
/// deployment ever runs more than one API process.
model JobRun {
  id         String    @id @default(uuid(7)) @db.Uuid
  jobName    String
  /// The unit of work this run covers — "2026-08" for monthly jobs, "2026-08-23"
  /// for daily ones. Together with jobName this makes every job idempotent.
  periodKey  String
  status     JobStatus @default(RUNNING)
  startedAt  DateTime  @default(now()) @db.Timestamptz(3)
  finishedAt DateTime? @db.Timestamptz(3)
  /// Truncated failure message. Never a full stack trace or provider payload.
  error      String?

  @@unique([jobName, periodKey])
  @@index([jobName, startedAt])
}

enum WebhookStatus {
  RECEIVED
  PROCESSED
  FAILED
}

/// Replay protection for provider webhooks. Providers retry; the same event will
/// arrive more than once, sometimes late and sometimes out of order.
///
/// A duplicate must return 200, not an error — an error tells the provider to
/// retry, which is the opposite of what a duplicate needs.
model WebhookEvent {
  id          String        @id @default(uuid(7)) @db.Uuid
  provider    String
  /// The provider's own event identifier — the idempotency key.
  eventId     String
  eventType   String
  status      WebhookStatus @default(RECEIVED)
  /// Hash of the raw body, for detecting a provider replaying an event id with
  /// different content. The payload itself is not stored: it contains payment
  /// identifiers and is not needed after processing.
  payloadHash String
  receivedAt  DateTime      @default(now()) @db.Timestamptz(3)
  processedAt DateTime?     @db.Timestamptz(3)
  error       String?

  @@unique([provider, eventId])
  @@index([provider, status, receivedAt])
}

// ---------------------------------------------------------------------------
// Property domain
//
// Property is the top-level operational entity. Organization is deliberately
// deferred (docs/0001-architecture.md) — every record carries propertyId, so
// adding an org above Property later is one table plus one FK, not a rewrite.
//
// Building and Floor are fields on Room rather than tables: nothing bills,
// allocates, authorizes or reports at floor level.
// ---------------------------------------------------------------------------

enum PropertyStatus {
  ACTIVE
  INACTIVE
}

/// A hostel/PG building operated as one unit.
model Property {
  id          String         @id @default(uuid(7)) @db.Uuid
  /// URL-safe public identifier. The guest experience is addressed by slug, never
  /// by id, so internal identifiers are never exposed publicly.
  slug        String         @unique
  name        String
  tagline     String?
  description String?
  status      PropertyStatus @default(ACTIVE)

  /// Whether the guest experience may show this property at all. Distinct from
  /// `status`: a property can be operating but withdrawn from public listing.
  isPubliclyListed Boolean @default(false)

  /// Business rules (due dates, mess cutoffs, late fees) run in this timezone,
  /// never the server's or the device's. See docs/0005-billing-rules.md.
  timezone String @default("Asia/Kolkata")
  currency String @default("INR")

  addressLine String
  locality    String
  city        String
  state       String
  pincode     String
  /// Coarse map location. Stored as Decimal, not Float — these are coordinates,
  /// not measurements, and must round-trip exactly.
  latitude    Decimal? @db.Decimal(9, 6)
  longitude   Decimal? @db.Decimal(9, 6)

  contactPhone String
  contactEmail String?

  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)

  photos      PropertyPhoto[]
  facilities  Facility[]
  rules       PropertyRule[]
  roomTypes   RoomType[]
  rooms       Room[]
  menuItems   WeeklyMenuItem[]
  memberships PropertyMembership[]

  @@index([isPubliclyListed, status])
}

model PropertyPhoto {
  id         String   @id @default(uuid(7)) @db.Uuid
  propertyId String   @db.Uuid
  property   Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  /// Object-storage key or absolute URL. Public photos only — tenant documents
  /// live in a private bucket and never appear here.
  url        String
  caption    String?
  sortOrder  Int      @default(0)

  @@index([propertyId, sortOrder])
}

model Facility {
  id         String   @id @default(uuid(7)) @db.Uuid
  propertyId String   @db.Uuid
  property   Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  label      String
  /// Icon name resolved by the client; the server stores no presentation markup.
  icon       String?
  sortOrder  Int      @default(0)

  @@unique([propertyId, label])
  @@index([propertyId, sortOrder])
}

model PropertyRule {
  id         String   @id @default(uuid(7)) @db.Uuid
  propertyId String   @db.Uuid
  property   Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  text       String
  sortOrder  Int      @default(0)

  @@index([propertyId, sortOrder])
}

/// A category of room — "3 Sharing (AC)" — carrying the pricing a guest sees.
/// Rent lives here as the advertised rate; the agreed rent for a specific stay is
/// captured on the Tenancy, because they legitimately differ.
model RoomType {
  id              String   @id @default(uuid(7)) @db.Uuid
  propertyId      String   @db.Uuid
  property        Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  name            String
  /// Beds per room of this type.
  sharingCapacity Int
  /// Advertised monthly rent, in paise. See docs/0002-money.md.
  baseRentPaise   Int
  /// Advertised security deposit, in paise.
  depositPaise    Int
  description     String?
  amenities       String[]
  sortOrder       Int      @default(0)

  rooms Room[]

  @@unique([propertyId, name])
  @@index([propertyId, sortOrder])
}

enum RoomStatus {
  ACTIVE
  MAINTENANCE
  INACTIVE
}

model Room {
  id         String     @id @default(uuid(7)) @db.Uuid
  propertyId String     @db.Uuid
  property   Property   @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  roomTypeId String     @db.Uuid
  roomType   RoomType   @relation(fields: [roomTypeId], references: [id], onDelete: Restrict)
  number     String
  /// Floor and block are labels, not entities — see the header comment.
  floor      Int        @default(0)
  block      String?
  status     RoomStatus @default(ACTIVE)

  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)

  beds Bed[]

  @@unique([propertyId, number])
  @@index([propertyId, status])
}

enum BedStatus {
  AVAILABLE
  OCCUPIED
  RESERVED
  MAINTENANCE
  BLOCKED
}

/// The unit that is actually let. Occupancy is tracked by Allocation rows in the
/// tenancy slice; `status` here is the operational state of the bed itself.
model Bed {
  id     String    @id @default(uuid(7)) @db.Uuid
  roomId String    @db.Uuid
  room   Room      @relation(fields: [roomId], references: [id], onDelete: Cascade)
  label  String
  status BedStatus @default(AVAILABLE)

  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)

  @@unique([roomId, label])
  @@index([status])
}

enum MealType {
  BREAKFAST
  LUNCH
  SNACKS
  DINNER
}

/// The published weekly menu. Guests see it as the food offering; the mess slice
/// will reuse it for expected meal counts.
model WeeklyMenuItem {
  id         String   @id @default(uuid(7)) @db.Uuid
  propertyId String   @db.Uuid
  property   Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  /// ISO-8601 day of week: 1 = Monday ... 7 = Sunday.
  dayOfWeek  Int
  mealType   MealType
  /// Dishes served, in serving order.
  items      String[]

  @@unique([propertyId, dayOfWeek, mealType])
  @@index([propertyId, dayOfWeek])
}

// ---------------------------------------------------------------------------
// Identity, access and audit
//
// User is a PERSON and exists once, forever. A stay is a Tenancy (next slice);
// leaving and returning creates a second Tenancy under the same User. This is why
// contact phone numbers are NOT globally unique — only login identity is.
//
// See docs/0003-auth-and-sessions.md and docs/0004-authorization.md.
// ---------------------------------------------------------------------------

enum UserStatus {
  /// Can sign in.
  ACTIVE
  /// Temporarily blocked by staff; credentials still valid.
  SUSPENDED
  /// Left, or exercised a deletion request. PII anonymised, financial history kept.
  DEACTIVATED
}

enum MembershipRole {
  OWNER
  MANAGER
  STAFF
  TENANT
}

model User {
  id String @id @default(uuid(7)) @db.Uuid

  /// Login identity. At least one of email/phone is required — enforced by a
  /// CHECK constraint in the migration, because Prisma cannot express it.
  email String? @unique
  phone String? @unique

  fullName     String
  passwordHash String?
  status       UserStatus @default(ACTIVE)

  /// Set for an admin-provisioned account until the first password is chosen.
  mustChangePassword Boolean @default(false)

  // --- Brute-force protection -------------------------------------------------
  // Persisted in PostgreSQL, not in memory: per-IP limits reset on every deploy
  // and are trivially evaded by rotating IPs. Per-account state is what actually
  // stops a targeted attack. See docs/0003-auth-and-sessions.md.
  failedLoginAttempts Int       @default(0)
  lockedUntil         DateTime? @db.Timestamptz(3)
  lastFailedLoginAt   DateTime? @db.Timestamptz(3)
  lastLoginAt         DateTime? @db.Timestamptz(3)

  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)

  memberships PropertyMembership[]
  sessions    RefreshSession[]
  auditLogs   AuditLog[]

  @@index([status])
}

/// Grants a user a role at a property. This is the single source of "who may do
/// what, where" — an OWNER is simply a membership with role OWNER.
model PropertyMembership {
  id         String         @id @default(uuid(7)) @db.Uuid
  userId     String         @db.Uuid
  user       User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  propertyId String         @db.Uuid
  property   Property       @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  role       MembershipRole

  createdAt DateTime @default(now()) @db.Timestamptz(3)

  /// One role per person per property. A second role would make authorization
  /// ambiguous, so the database refuses it.
  @@unique([userId, propertyId])
  @@index([propertyId, role])
}

/// A refresh token, stored only as a hash.
///
/// Tokens belong to a family. Presenting an already-revoked token means it was
/// replayed — the whole family is revoked, because that is the signature of a
/// stolen token rather than a normal refresh.
model RefreshSession {
  id     String @id @default(uuid(7)) @db.Uuid
  userId String @db.Uuid
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  /// SHA-256 of the token. The raw token is never stored, so a database leak
  /// does not hand over live sessions.
  tokenHash String @unique
  familyId  String @db.Uuid

  /// Shown in the user's device/session list.
  deviceLabel String?
  ipAddress   String?

  createdAt    DateTime  @default(now()) @db.Timestamptz(3)
  expiresAt    DateTime  @db.Timestamptz(3)
  revokedAt    DateTime? @db.Timestamptz(3)
  replacedById String?   @db.Uuid

  @@index([userId, revokedAt])
  @@index([familyId])
  @@index([expiresAt])
}

/// Append-only record of sensitive actions. There is no update or delete path
/// anywhere in the codebase.
///
/// `before`/`after` hold a REDACTED field allowlist, never a whole row — an
/// unrestricted diff would make this the leakiest table in the database.
/// See docs/0008-data-protection.md.
model AuditLog {
  id String @id @default(uuid(7)) @db.Uuid

  /// Null for system/scheduled actions, which have no human actor.
  actorUserId String? @db.Uuid
  actorUser   User?   @relation(fields: [actorUserId], references: [id], onDelete: SetNull)
  actorRole   String?

  action     String
  entityType String
  entityId   String?
  propertyId String? @db.Uuid

  before Json?
  after  Json?

  ipAddress String?
  requestId String?

  createdAt DateTime @default(now()) @db.Timestamptz(3)

  @@index([entityType, entityId])
  @@index([propertyId, createdAt])
  @@index([actorUserId, createdAt])
}

{
  "expo": {
    "name": "The Heaven Hospitality",
    "slug": "heaven-hospitality",
    "version": "0.1.0",
    "orientation": "portrait",
    "icon": "./assets/icon/icon.png",
    "scheme": "heavenhospitality",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/icon/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#000000"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "in.heavenhospitality.app",
      "infoPlist": {
        "LSApplicationQueriesSchemes": [
          "tez",
          "gpay",
          "phonepe",
          "paytmmp",
          "credpay",
          "mobikwik",
          "in.fampay.app",
          "myjio",
          "upi"
        ]
      }
    },
    "android": {
      "package": "in.heavenhospitality.app",
      "edgeToEdgeEnabled": true,
      "adaptiveIcon": {
        "foregroundImage": "./assets/icon/adaptive-icon.png",
        "backgroundColor": "#a5621f"
      }
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "expo-dev-client",
      "expo-notifications",
      "./plugins/withExternalAppQueries.js"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "apiBaseUrl": "https://3-104-19-26.sslip.io/api/v1",
      "propertySlug": "heaven-hospitality-kothrud",
      "router": {},
      "eas": {
        "projectId": "c510e93f-2e32-4354-af74-7f9e2cad0b4d"
      }
    },
    "owner": "divyanshguptaj"
  }
}

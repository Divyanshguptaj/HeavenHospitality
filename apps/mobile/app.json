{
  "expo": {
    "name": "The Heaven Hospitality",
    "slug": "heaven-hospitality",
    "version": "0.1.0",
    "orientation": "portrait",
    "icon": "./assets/icon/icon.png",
    "scheme": "heavenhospitality",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/icon/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#FFFFFF"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "in.theheavenhospitality.app",
      "infoPlist": {
        "LSApplicationQueriesSchemes": [
          "tez",
          "gpay",
          "phonepe",
          "paytmmp",
          "credpay",
          "mobikwik",
          "in.fampay.app",
          "myjio",
          "upi"
        ]
      }
    },
    "android": {
      "package": "in.theheavenhospitality.app",
      "edgeToEdgeEnabled": true,
      "adaptiveIcon": {
        "foregroundImage": "./assets/icon/adaptive-icon.png",
        "backgroundColor": "#FFFFFF"
      },
      "blockedPermissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.SYSTEM_ALERT_WINDOW",
        "android.permission.WRITE_CONTACTS"
      ],
      "permissions": [
        "android.permission.READ_CONTACTS",
        "android.permission.WRITE_CONTACTS"
      ]
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "expo-dev-client",
      [
        "expo-notifications",
        {
          "icon": "./assets/icon/notification-icon.png",
          "color": "#0E2E5D"
        }
      ],
      [
        "expo-contacts",
        {
          "contactsPermission": "Allow The Heaven Hospitality to open the new-contact form so you can save the property number."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow The Heaven Hospitality to access your photos so you can attach a profile photo or document.",
          "cameraPermission": "Allow The Heaven Hospitality to use the camera so you can take a photo of a document.",
          "microphonePermission": false
        }
      ],
      "./plugins/withExternalAppQueries.js"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "apiBaseUrl": "https://3-104-19-26.sslip.io/api/v1",
      "propertySlug": "heaven-hospitality-kothrud",
      "router": {},
      "eas": {
        "projectId": "c92871d5-0874-4825-8a7f-2da5d256ccc0"
      }
    },
    "owner": "vijaysinghlabanas-team"
  }
}
